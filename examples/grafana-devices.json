          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "drawStyle": "bars",
            "barAlignment": -1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Energy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
