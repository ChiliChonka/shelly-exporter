        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Energy per day",
      "description": "One bar per calendar day (UTC), last 30 days. The bar for a day appears once the day is over.",
